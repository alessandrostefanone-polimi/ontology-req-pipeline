# OpenAI provider
OPENAI_API_KEY=your_openai_api_key

# Ollama provider (only needed when using --provider ollama)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama

# QUDT semantic lookup. Local is the default and builds a persistent index
# automatically from the QUDT CSV bundled with this repository.
QUDT_CHROMA_BACKEND=local
QUDT_CHROMA_PATH=artifacts/cache/qudt-chroma
CHROMA_COLLECTION=qudt_quantity_kinds_with_descriptions

# Required only when QUDT_CHROMA_BACKEND=cloud (or auto with cloud enabled).
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=

# PDF document extraction defaults (the UI also exposes these settings).
DOCUMENT_PROVIDER=ollama
DOCUMENT_MODEL=qwen3.5:9b-bf16
DOCUMENT_MAX_WORKERS=4
DOCUMENT_HIGH_THRESHOLD=35
DOCUMENT_AMBIGUOUS_THRESHOLD=15
DOCUMENT_OLLAMA_NUM_CTX=8192
DOCUMENT_OLLAMA_NUM_PREDICT=3072
DOCUMENT_PROMPT_TOKEN_BUDGET=4096
DOCUMENT_LOW_BATCH_MAX_TOKENS=3072
